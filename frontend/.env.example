# PhishGuard AI - Frontend Environment Configuration
#
# 1. Local Development (default in .env.local):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# 2. Vercel Production Deployment:
# Set this in your Vercel Project Dashboard (Settings -> Environment Variables)
# to the live URL of your deployed FastAPI backend project:
NEXT_PUBLIC_API_URL=https://your-phishguard-api.vercel.app
